# Copy to .env and fill in what you need (this file is loaded by app/main.py
# and app/ai_evaluate.py via python-dotenv). .env itself is gitignored.

# AI evaluation backend (app/ai_evaluate.py):
#   api         (default) Anthropic API, billed per call; needs ANTHROPIC_API_KEY.
#   claude-cli  Your signed-in Claude Code CLI (`claude -p`), which uses your
#               own Claude subscription instead of API credits. Personal use
#               only; see the README's "Using your Claude subscription".
AI_BACKEND=api

# Required only with AI_BACKEND=api. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional, claude-cli backend only: full path to `claude` if it isn't on PATH.
# CLAUDE_CLI_PATH=

# Optional: override the default model (claude-haiku-4-5) used for scoring
# (applies to both backends).
# ANTHROPIC_MODEL=claude-haiku-4-5

# Required only if you enable an Adzuna entry in aggregators.yaml.
# Free signup at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
